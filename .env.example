# CODEVERSE environment variables
# Copy this file to .env.local and fill in real values. Never commit .env files.

# JWT signing secret — REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Where LowDB stores codeverse.json.
# Local default: ./data
# Render: set to the mounted disk path, e.g. /var/data
DATA_DIR=./data

# Environment
NODE_ENV=development
